# ==============================================================
# ALBEDO-BOT CONFIGURATION
# ==============================================================

# Mode Environment: 'development' | 'production' | 'staging'
NODE_ENV=development

# Identitas Bot
BOT_NAME=ALBEDO
BOT_PREFIX=.

# Metode Login WhatsApp: 'qr' (scan QR di terminal) atau 'code' (pairing code 8-digit)
LOGIN_METHOD=qr
# Nomor WhatsApp bot (wajib diisi jika LOGIN_METHOD=code, tanpa tanda + atau spasi)
PAIRING_NUMBER=628......

# Kontak & Informasi Owner
OWNER_NUMBER=6285746345170
OWNER_NAME=Varo
OWNER_ROLE=OWNER BOT
OWNER_CONTACT=6285111411152
DONATE_INFO=Hubungi owner untuk detail donasi operasional bot.

# Informasi Developer
DEV_NAME=Varo
DEV_ROLE=Developer
DEV_GITHUB=https://github.com/varooats
DEV_WEBSITE=https://varooats.xyz
DEV_INSTAGRAM=@varooats

# APMIX AI Configuration (DeepSeek / OpenAI Compatible)
APMIX_BASE_URL=https://api.apmix.ai/v1
APMIX_API_KEY=apx_live_xxxxxx
APMIX_MODEL=deepseek-v4-flash-free

# Log Level: 'debug' | 'info' | 'warn' | 'error'
LOG_LEVEL=info

# ==============================================================
# FIREBASE CREDENTIALS (Pilih salah satu metode di bawah)
# ==============================================================

# METODE 1: Path file JSON (Rekomendasi untuk VPS / Local)
FIREBASE_CREDENTIALS_PATH=./src/database/secrets/firebase-service-account.json

# METODE 2: Variabel terpisah per field (Rekomendasi jika tanpa upload file)
# FIREBASE_PROJECT_ID=albedo-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@albedo-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# METODE 3: JSON Minified atau Base64 String (Rekomendasi untuk Railway / Heroku / Docker)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}
# Atau base64:
# FIREBASE_SERVICE_ACCOUNT=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwicHJvamVjdF9pZCI6Ii4uLiJ9
