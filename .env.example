# ==============================================================
# ALBEDO-BOT CONFIGURATION
# ==============================================================

# Identitas Bot
BOT_NAME=ALBEDO
BOT_PREFIX=.
NODE_ENV=development

# Metode Login WhatsApp: 'qr' (scan QR di terminal) atau 'code' (pairing code 8-digit)
LOGIN_METHOD=qr
# Nomor WhatsApp bot (wajib diisi jika LOGIN_METHOD=code, tanpa tanda + atau spasi)
PAIRING_NUMBER=628......

# Kontak & Informasi Owner
OWNER_NUMBER=6285746345170
OWNER_NAME=Varo
OWNER_ROLE=OWNER BOT
OWNER_CONTACT=6285111411152
DONATE_INFO=Hubungi owner untuk detail donasi operasional bot.

# Informasi Developer
DEV_NAME=Varo
DEV_ROLE=Developer
DEV_GITHUB=https://github.com/varooats
DEV_WEBSITE=https://varooats.xyz
DEV_INSTAGRAM=@varooats

# Database SQLite (Optional / Local Cache)
DATABASE_URL=sqlite://./storage/database.db
DB_DIALECT=sqlite

# ==============================================================
# FIREBASE CREDENTIALS (Pilih salah satu metode yang paling mudah)
# ==============================================================

# --- METODE 1 (PALING MUDAH & BERSIH): Path ke file JSON kredensial ---
# Simpan file JSON dari Firebase Console di mana saja (misal: ./firebase-key.json) lalu isi path-nya:
FIREBASE_CREDENTIALS_PATH=./src/database/secrets/albedo-4b16f-firebase-adminsdk-fbsvc-b6d0ea4105.json

# --- METODE 2: Terpisah per kolom (Mudah di-edit langsung di .env) ---
# FIREBASE_PROJECT_ID=albedo-4b16f
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@albedo-4b16f.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvwIBADANBgk...\n-----END PRIVATE KEY-----\n"

# --- METODE 3: JSON String Utuh atau Base64 Encoded (Cocok untuk Cloud Deployment) ---
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"albedo-4b16f",...}
